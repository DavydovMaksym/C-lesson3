namespace C_lesson3._2
{
    internal class Program
    {
        static bool IsPrime(int n)
        {
            if (n < 2)
            {
                return false;
            }

            for (int i = 2; i * i <= n; i++)
            {
                if (n % i == 0)
                {
                    return false;
                }
            }
            return true;
        }

        static bool IsFibonacci(int n)
        {
            if (n < 0)
            {
                return false;
            }

            int a = 0;
            int b = 1;

            while (b < n)
            {
                int temp = b;
                b = a + b;
                a = temp;
            }

            return b == n;
        }
        static bool IsFibonacciPrime(int number)
        {
            return IsFibonacci(number) && IsPrime(number);
        }

        static void Main()
        {
            Console.Write("Enter a number: ");
            int num = int.Parse(Console.ReadLine());

            if (IsFibonacciPrime(num))
            {
                Console.WriteLine($"{num} is a prime Fibonacci number.");
            }
            else
            {
                Console.WriteLine($"{num} is NOT a prime Fibonacci number.");
            }
        }
    }
}
